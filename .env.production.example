# Copy this file to .env on the server. Never commit the resulting .env file.
# Generate the three secret values independently with: openssl rand -hex 32
PLATFORM_TOKEN=
SESSION_SECRET=
RUNNER_SHARED_SECRET=
SESSION_TTL_HOURS=12
SNAPSHOT_INTERVAL_MINUTES=60
API_PORT=8000
FRONTEND_PORT=3000
# Keep empty unless the Docker-side address of a trusted host proxy is fixed.
TRUSTED_PROXY_CIDRS=
