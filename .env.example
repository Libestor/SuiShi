MYSQL_DATABASE=investment_overview
MYSQL_USER=investment
MYSQL_PASSWORD=investment_dev_password
MYSQL_ROOT_PASSWORD=investment_root_dev_password
# 分别使用 `openssl rand -hex 32` 生成三个不同的值；留空时服务拒绝启动。
PLATFORM_TOKEN=
SESSION_SECRET=
SESSION_TTL_HOURS=12
SESSION_COOKIE_SECURE=false
RUNNER_SHARED_SECRET=
SNAPSHOT_INTERVAL_MINUTES=60
# Keep false for real data. Set true only for an isolated local demo database.
SEED_DEMO_DATA=false
API_PORT=8000
FRONTEND_PORT=3000
GATEWAY_PORT=8080
RUNNER_PORT=9000
# 使用 htpasswd 或 openssl 创建不纳入版本控制的文件，并填写绝对路径。
BASIC_AUTH_FILE=
GATEWAY_IP=172.31.251.10
EDGE_SUBNET=172.31.251.0/24
